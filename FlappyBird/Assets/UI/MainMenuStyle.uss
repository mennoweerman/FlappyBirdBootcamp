.header {
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
}

.button {
    font-size: 48px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/TradeWinds-Regular.ttf?fileID=12800000&guid=5c0169bebec678749a3dff75d3cdef83&type=3#TradeWinds-Regular");
    color: rgb(255, 255, 255);
    text-shadow: 2px 0 0 rgb(0, 0, 0);
    background-color: rgb(195, 34, 34);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    width: 220px;
    height: 90px;
    align-self: center;
    justify-content: center;
    margin-top: 0;
}
