#highscore-label {
    font-size: 20px;
    color: white;
    unity-font: resource("Fonts/MyCustomFont");
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

#score-label {
    font-size: 24px;
    color: white;
    unity-font: resource("Fonts/MyCustomFont");
    position: absolute;
    top: 10px;
    left: 10px;
}

#gameover-label {
    font-size: 48px;
    unity-font: resource("Fonts/MyCustomFont");
    color: red;
    unity-text-align: middle-center;
    position: absolute;
    top: 15%;
    left: 50%;
    -unity-text-align: middle-center;
    translate: -50% -50%;
}

#restart-button {
    font-size: 14px;
    unity-font: resource("Fonts/MyCustomFont");
    position: absolute;
    top: 60%;
    left: 50%;
    translate: -50% -50%;
    width: 80px;
    height: 30px;
}
